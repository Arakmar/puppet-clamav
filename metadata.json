{
  "name": "arakmar-clamav",
  "version": "3.0.0",
  "author": "Yoann Laissus",
  "summary": "ClamAV scanner daemon, freshclam updater and milter",
  "license": "GPL-3.0-or-later",
  "source": "https://github.com/Arakmar/puppet-clamav",
  "project_page": "https://github.com/Arakmar/puppet-clamav",
  "issues_url": "https://github.com/Arakmar/puppet-clamav/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppet/epel",
      "version_requirement": ">= 5.0.0 < 7.0.0"
    },
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 8.2.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "Archlinux"
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ]
}
